(pcb Plane-teardrops.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  20000 0  20000 18000  0 18000  0 0))
    (plane N0 (polygon F.Cu 0  8000 1400  9000 1100  9000 1900  8000 1600  8000 1400))
    (plane N0 (polygon F.Cu 0  12000 1400  11000 1100  11000 1900  12000 1600  12000 1400))
    (plane N1 (polygon F.Cu 0  8000 5400  9000 5100  9000 5900  8000 5600  8000 5400))
    (plane N1 (polygon F.Cu 0  12000 5400  11000 5100  11000 5900  12000 5600  12000 5400))
    (plane N2 (polygon F.Cu 0  8000 9400  9000 9100  9000 9900  8000 9600  8000 9400))
    (plane N2 (polygon F.Cu 0  12000 9400  11000 9100  11000 9900  12000 9600  12000 9400))
    (plane N3 (polygon F.Cu 0  8000 13400  9000 13100  9000 13900  8000 13600  8000 13400))
    (plane N3 (polygon F.Cu 0  12000 13400  11000 13100  11000 13900  12000 13600  12000 13400))
    (via "Via[0-1]_800:400_um")
    (rule (width 200) (clearance 200))
  )
  (placement
    (component THT
      (place A0 1500 1500 front 0)
      (place B0 18500 1500 front 0)
      (place A1 1500 5500 front 0)
      (place B1 18500 5500 front 0)
      (place A2 1500 9500 front 0)
      (place B2 18500 9500 front 0)
      (place A3 1500 13500 front 0)
      (place B3 18500 13500 front 0)
    )
  )
  (library
    (image THT (pin Round 1 0 0))
    (padstack Round (shape (circle F.Cu 1600)) (shape (circle B.Cu 1600)) (attach off))
    (padstack "Via[0-1]_800:400_um" (shape (circle F.Cu 800)) (shape (circle B.Cu 800)) (attach off))
  )
  (network
    (net N0 (pins A0-1 B0-1))
    (net N1 (pins A1-1 B1-1))
    (net N2 (pins A2-1 B2-1))
    (net N3 (pins A3-1 B3-1))
    (class kicad_default N0 N1 N2 N3 (circuit (use_via "Via[0-1]_800:400_um")) (rule (width 200) (clearance 200)))
  )
  (wiring
    (wire (path F.Cu 200  1500 1500  8000 1500)(net N0)(type route))
    (wire (path F.Cu 200  18500 1500  12000 1500)(net N0)(type route))
    (wire (path F.Cu 200  1500 5500  8000 5500)(net N1)(type route))
    (wire (path F.Cu 200  18500 5500  12000 5500)(net N1)(type route))
    (wire (path F.Cu 200  1500 9500  8000 9500)(net N2)(type route))
    (wire (path F.Cu 200  18500 9500  12000 9500)(net N2)(type route))
    (wire (path F.Cu 200  1500 13500  8000 13500)(net N3)(type route))
    (wire (path F.Cu 200  18500 13500  12000 13500)(net N3)(type route))
  )
)
