(pcb slanted_corridor
  (resolution um 1)
  (unit um)
  (structure
    (layer top (type signal))
    (boundary (path pcb 0 0 0 10000 3000 10000 4000 0 1000 0 0))
    (via V)
    (rule (width 100) (clearance 100)))
  (placement
    (component P
      (place A 1000 800 front 0)
      (place B 9000 3200 front 0)))
  (library
    (image P (pin S 1 0 0))
    (padstack S (shape (circle top 200)))
    (padstack V (shape (circle top 200)) (attach off)))
  (network (net N (pins A-1 B-1))))
