(pcb Issue1161-shove-into-zone.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer Top (type signal) (property (index 0)))
    (layer Bottom (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  12000 0  12000 12000  0 12000  0 0))
    (plane GND (polygon Top 0  2500 2000  7650 2000  7650 5200  2500 5200  2500 2000))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 150))
  )
  (placement
    (component SMD_TOP
      (place A 1500 1500 front 0)
    )
    (component SMD_BOT
      (place B 1500 10500 back 0)
    )
  )
  (library
    (image SMD_TOP (pin PadTop 1 0 0))
    (image SMD_BOT (pin PadBot 1 0 0))
    (padstack PadTop (shape (rect Top -500 -500 500 500)) (attach off))
    (padstack PadBot (shape (rect Bottom -500 -500 500 500)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle Top 600)) (shape (circle Bottom 600)) (attach off))
  )
  (network
    (net GND)
    (net SIG (pins A-1 B-1))
    (class kicad_default GND SIG (circuit (use_via "Via[0-1]_600:300_um")) (rule (width 200) (clearance 150)))
  )
  (wiring
    (wire (path Top 200  1500 1500  8000 1500  8000 6000)(net SIG)(type route))
    (wire (path Bottom 200  1500 10500  8000 10500  8000 6000)(net SIG)(type route))
    (via "Via[0-1]_600:300_um"  8000 6000 (net SIG)(type route))
  )
)
