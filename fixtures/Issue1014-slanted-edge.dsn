(pcb slanted_edge
  (resolution um 1)
  (unit um)
  (structure
    (layer top (type signal))
    (layer bottom (type signal))
    (boundary (path pcb 0 0 0 100000 30000 100000 100000 0 100000 0 0))
    (via V)
    (rule (width 200) (clearance 200)))
  (placement
    (component P
      (place A 50000 18000 front 0)
      (place B 65000 24000 front 0)))
  (library
    (image P (pin S 1 0 0))
    (padstack S (shape (circle top 600)))
    (padstack V (shape (circle top 600)) (shape (circle bottom 600)) (attach off)))
  (network (net N (pins A-1 B-1))))
