(pcb stub-centre
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer Top (type signal) (property (index 0)))
    (layer Bottom (type signal) (property (index 1)))
    (boundary (rect pcb 8800 -20077 28800 -77))
    (via "Via[0-1]_400:200_um")
    (rule (width 100) (clearance 274) (clearance 25 (type smd_smd)))
  )
  (placement
    (component QFN20 (place U1 18800 -10077 front 45))
    (component TGT
      (place T1 19036 -17073 front 0)
      (place T2 20775 -16793 front 0)
      (place T3 22784 -15832 front 0)
      (place T4 24555 -14061 front 0)
      (place T5 25516 -12052 front 0)
      (place T6 25796 -10313 front 0)
      (place T7 25314 -7515 front 0)
      (place T8 24361 -5825 front 0)
      (place T9 23052 -4516 front 0)
      (place T10 21362 -3563 front 0)
      (place T11 18564 -3081 front 0)
      (place T12 16825 -3361 front 0)
      (place T13 14816 -4322 front 0)
      (place T14 13045 -6093 front 0)
      (place T15 12084 -8102 front 0)
      (place T16 11804 -9841 front 0)
      (place T17 12286 -12639 front 0)
      (place T18 13239 -14329 front 0)
      (place T19 14548 -15638 front 0)
      (place T20 16238 -16591 front 0)
    )
  )
  (library
    (image QFN20
      (pin C (rotate 180) 1 -1075 -1150)
      (pin S 2 -600 -1100)
      (pin S 3 -200 -1100)
      (pin S 4 200 -1100)
      (pin S 5 600 -1100)
      (pin C (rotate 180) 6 1075 -1150)
      (pin C (rotate 90) 7 1550 -675)
      (pin S (rotate 90) 8 1500 -200)
      (pin S (rotate 90) 9 1500 200)
      (pin C (rotate 90) 10 1550 675)
      (pin C (rotate 180) 11 1075 1150)
      (pin S 12 600 1100)
      (pin S 13 200 1100)
      (pin S 14 -200 1100)
      (pin S 15 -600 1100)
      (pin C (rotate 180) 16 -1075 1150)
      (pin C (rotate 90) 17 -1550 675)
      (pin S (rotate 90) 18 -1500 200)
      (pin S (rotate 90) 19 -1500 -200)
      (pin C (rotate 90) 20 -1550 -675)
      (pin E 21 0 0)
    )
    (image TGT (pin T 1 0 0))
    (padstack S (shape (rect Top -75 -300 75 300)) (attach off))
    (padstack C (shape (rect Top -125 -250 125 250)) (attach off))
    (padstack E (shape (rect Top -900 -500 900 500)) (attach off))
    (padstack T (shape (rect Top -300 -300 300 300)) (attach off))
    (padstack "Via[0-1]_400:200_um" (shape (circle Top 400)) (shape (circle Bottom 400)) (attach off))
  )
  (network
    (net N1 (pins U1-1 T1-1))
    (net N2 (pins U1-2 T2-1))
    (net N3 (pins U1-3 T3-1))
    (net N4 (pins U1-4 T4-1))
    (net N5 (pins U1-5 T5-1))
    (net N6 (pins U1-6 T6-1))
    (net N7 (pins U1-7 T7-1))
    (net N8 (pins U1-8 T8-1))
    (net N9 (pins U1-9 T9-1))
    (net N10 (pins U1-10 T10-1))
    (net N11 (pins U1-11 T11-1))
    (net N12 (pins U1-12 T12-1))
    (net N13 (pins U1-13 T13-1))
    (net N14 (pins U1-14 T14-1))
    (net N15 (pins U1-15 T15-1))
    (net N16 (pins U1-16 T16-1))
    (net N17 (pins U1-17 T17-1))
    (net N18 (pins U1-18 T18-1))
    (net N19 (pins U1-19 T19-1))
    (net N20 (pins U1-20 T20-1))
    (class kicad_default N1 N2 N3 N4 N5 N6 N7 N8 N9 N10 N11 N12 N13 N14 N15 N16 N17 N18 N19 N20 (circuit (use_via "Via[0-1]_400:200_um")) (rule (width 100) (clearance 274)))
  )
  (wiring
  )
)
