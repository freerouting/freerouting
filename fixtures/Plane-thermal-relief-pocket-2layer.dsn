(pcb "Plane-thermal-relief-pocket-2layer.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.8-10.0.8~ubuntu24.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  40000 -25000  0 -25000  0 0  40000 0  40000 -25000)
    )
    (plane GND (polygon F.Cu 0  1000 -1000  39000 -1000  39000 -24000  1000 -24000  1000 -1000))
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component PinHeader_1x01_P2.54mm_Vertical
      (place J2 32000 -12500 front 0 (PN PinHeader_1x01_P2.54mm_Vertical))
      (place J1 22000 -12500 front 0 (PN PinHeader_1x01_P2.54mm_Vertical))
      (place J3 18000 -20000 front 0 (PN PinHeader_1x01_P2.54mm_Vertical))
    )
    (component TestPoint_Pad_1.0x1.0mm
      (place TP1 2600 -12500 front 0 (PN TestPoint_Pad_1.0x1.0mm))
    )
    (component Shield_Bar_0.6x23.8mm
      (place SH1 5000 -12500 front 0 (PN Shield_Bar_0.6x23.8mm))
    )
  )
  (library
    (image PinHeader_1x01_P2.54mm_Vertical
      (outline (polygon signal 0  1765 -1765  -1765 -1765  -1765 1765  1765 1765))
      (outline (path signal 120  -1380 1380  0 1380))
      (outline (path signal 120  -1380 0  -1380 1380))
      (outline (path signal 120  -1380 -1270  -1380 -1380))
      (outline (path signal 120  -1380 -1270  1380 -1270))
      (outline (path signal 120  -1380 -1380  1380 -1380))
      (outline (path signal 120  1380 -1270  1380 -1380))
      (outline (path signal 100  -1270 635  -635 1270))
      (outline (path signal 100  -1270 -1270  -1270 635))
      (outline (path signal 100  -635 1270  1270 1270))
      (outline (path signal 100  1270 1270  1270 -1270))
      (outline (path signal 100  1270 -1270  -1270 -1270))
      (pin Rect[A]Pad_1700.000000x1700.000000_um 1 0 0)
    )
    (image TestPoint_Pad_1.0x1.0mm
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 0)
    )
    (image Shield_Bar_0.6x23.8mm
      (pin Rect[T]Pad_600.000000x23800.000000_um 1 0 0)
    )
    (padstack Rect[T]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack Rect[T]Pad_600.000000x23800.000000_um
      (shape (rect F.Cu -300 -11900 300 11900))
      (attach off)
    )
    (padstack Rect[A]Pad_1700.000000x1700.000000_um
      (shape (rect F.Cu -850 -850 850 850))
      (shape (rect B.Cu -850 -850 850 850))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net GND
      (pins J2-1 J1-1 TP1-1 SH1-1)
    )
    (net SIG
      (pins J3-1)
    )
    (class kicad_default GND SIG
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
  )
  (wiring
    (via "Via[0-1]_600:300_um" 19925 -12500 (net SIG)(type protect))
    (via "Via[0-1]_600:300_um" 24075 -12500 (net SIG)(type protect))
    (via "Via[0-1]_600:300_um" 22000 -14575 (net SIG)(type protect))
    (via "Via[0-1]_600:300_um" 22000 -10225 (net SIG)(type protect))
    (wire (path F.Cu 250  22000 -12500  23100 -12500)(net GND)(type protect))
    (wire (path B.Cu 250  22000 -10225  19925 -10225  19925 -12500)(net SIG)(type protect))
    (wire (path B.Cu 250  19925 -12500  19925 -14575  22000 -14575)(net SIG)(type protect))
    (wire (path B.Cu 250  22000 -14575  24075 -14575  24075 -12500)(net SIG)(type protect))
    (wire (path B.Cu 250  19925 -14575  19925 -20000  18000 -20000)(net SIG)(type protect))
  )
)
