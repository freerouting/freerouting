(pcb "Plane-floating-fragment-2layer.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.8-10.0.8~ubuntu24.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  40000 -25000  0 -25000  0 0  40000 0  40000 -25000)
    )
    (plane GND (polygon F.Cu 0  1000 -1000  18000 -1000  18000 -24000  1000 -24000  1000 -1000))
    (plane GND (polygon F.Cu 0  22000 -1000  39000 -1000  39000 -24000  22000 -24000  22000 -1000))
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component PinHeader_1x01_P2.54mm_Vertical
      (place J2 12000 -12500 front 0 (PN PinHeader_1x01_P2.54mm_Vertical))
      (place J1 8000 -12500 front 0 (PN PinHeader_1x01_P2.54mm_Vertical))
    )
  )
  (library
    (image PinHeader_1x01_P2.54mm_Vertical
      (outline (polygon signal 0  1765 -1765  -1765 -1765  -1765 1765  1765 1765))
      (outline (path signal 120  -1380 1380  0 1380))
      (outline (path signal 120  -1380 0  -1380 1380))
      (outline (path signal 120  -1380 -1270  -1380 -1380))
      (outline (path signal 120  -1380 -1270  1380 -1270))
      (outline (path signal 120  -1380 -1380  1380 -1380))
      (outline (path signal 120  1380 -1270  1380 -1380))
      (outline (path signal 100  -1270 635  -635 1270))
      (outline (path signal 100  -1270 -1270  -1270 635))
      (outline (path signal 100  -635 1270  1270 1270))
      (outline (path signal 100  1270 1270  1270 -1270))
      (outline (path signal 100  1270 -1270  -1270 -1270))
      (pin Rect[A]Pad_1700.000000x1700.000000_um 1 0 0)
    )
    (padstack Rect[A]Pad_1700.000000x1700.000000_um
      (shape (rect F.Cu -850 -850 850 850))
      (shape (rect B.Cu -850 -850 850 850))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net GND
      (pins J2-1 J1-1)
    )
    (class kicad_default GND
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
