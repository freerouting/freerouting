(pcb star-ground-fromto.dsn
  (resolution um 10) (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0 0 0 30000 0 30000 -20000 0 -20000 0 0))
    (via "Via[0-1]_600:300_um")
    (rule (width 250) (clearance 200)))
  (placement
    (component Pad800
      (place R 4000 -10000 front 0)
      (place A 24000 -5000 front 0)
      (place B 24000 -10000 front 0)
      (place C 24000 -15000 front 0)))
  (library
    (image Pad800 (pin Smd800 1 0 0))
    (padstack Smd800 (shape (rect F.Cu -400 -400 400 400)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle F.Cu 600 0 0)) (shape (circle B.Cu 600 0 0)) (attach off)))
  (network
    (net GND (fromto R-1 A-1) (fromto R-1 B-1) (fromto R-1 C-1))
    (class default GND (rule (width 250) (clearance 200)))))
