(pcb Issue1161-via-next-to-zone-tip.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer Top (type signal) (property (index 0)))
    (layer Bottom (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  16000 0  16000 10000  0 10000  0 0))
    (plane GND (polygon Top 0  8323 6134  10152 6945  10190 6853  8323 6134))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 150))
  )
  (placement
    (component SMD
      (place A 1500 1500 front 0)
    )
  )
  (library
    (image SMD (pin Pad 1 0 0))
    (padstack Pad (shape (rect Top -500 -500 500 500)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle Top 600)) (shape (circle Bottom 600)) (attach off))
  )
  (network
    (net GND)
    (net SIG (pins A-1))
    (class kicad_default GND SIG (circuit (use_via "Via[0-1]_600:300_um")) (rule (width 200) (clearance 150)))
  )
  (wiring
    (wire (path Top 200  1500 1500  8000 1500  8000 6000)(net SIG)(type route))
    (via "Via[0-1]_600:300_um"  8000 6000 (net SIG)(type route))
  )
)
