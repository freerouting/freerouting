(pcb Plane-fork-vias.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "hand") (host_version "1"))
  (resolution um 10)
  (unit um)
  (structure
    (layer Top (type signal) (property (index 0)))
    (layer In1 (type power) (property (index 1)))
    (layer In2 (type signal) (property (index 2)))
    (layer Bottom (type signal) (property (index 3)))
    (boundary (path pcb 0  0 0  16000 0  16000 14000  0 14000  0 0))
    (plane GND (polygon In1 0  500 500  15500 500  15500 13500  500 13500))
    (via "Via[0-3]_600:300_um")
    (rule (width 200) (clearance 150))
  )
  (placement
    (component SMD
      (place A0 1500 1500 front 0)
      (place B0 14500 1500 front 0)
      (place A1 1500 4500 front 0)
      (place B1 14500 4500 front 0)
      (place A2 1500 7500 front 0)
      (place B2 14500 7500 front 0)
      (place A3 1500 10500 front 0)
      (place B3 14500 10500 front 0)
    )
  )
  (library
    (image SMD (pin Pad 1 0 0))
    (padstack Pad (shape (rect Top -500 -500 500 500)) (attach off))
    (padstack "Via[0-3]_600:300_um" (shape (circle Top 600)) (shape (circle In1 600)) (shape (circle In2 600)) (shape (circle Bottom 600)) (attach off))
  )
  (network
    (net GND (pins A0-1 B0-1 A1-1 B1-1 A2-1 B2-1 A3-1 B3-1))
    (class kicad_default GND (circuit (use_via "Via[0-3]_600:300_um")) (rule (width 200) (clearance 150)))
  )
  (wiring
    (wire (path Top 200  1500 1500  4000 1500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  4000 1500 (net GND)(type route))
    (wire (path In2 200  4000 1500  12000 1500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  12000 1500 (net GND)(type route))
    (wire (path Top 200  12000 1500  14500 1500)(net GND)(type route))
    (wire (path Top 200  1500 4500  4000 4500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  4000 4500 (net GND)(type route))
    (wire (path In2 200  4000 4500  12000 4500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  12000 4500 (net GND)(type route))
    (wire (path Top 200  12000 4500  14500 4500)(net GND)(type route))
    (wire (path Top 200  1500 7500  4000 7500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  4000 7500 (net GND)(type route))
    (wire (path In2 200  4000 7500  12000 7500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  12000 7500 (net GND)(type route))
    (wire (path Top 200  12000 7500  14500 7500)(net GND)(type route))
    (wire (path Top 200  1500 10500  4000 10500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  4000 10500 (net GND)(type route))
    (wire (path In2 200  4000 10500  12000 10500)(net GND)(type route))
    (via "Via[0-3]_600:300_um"  12000 10500 (net GND)(type route))
    (wire (path Top 200  12000 10500  14500 10500)(net GND)(type route))
  )
)
