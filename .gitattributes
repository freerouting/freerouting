# Shell scripts must always use LF line endings (CRLF breaks the shebang on Linux/macOS)
*.sh        text eol=lf

# Java and build/source metadata use LF on every platform.
*.java      text eol=lf
*.gradle    text eol=lf
*.groovy    text eol=lf
*.json      text eol=lf
*.properties text eol=lf
*.py        text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf

# Windows batch files use CRLF
*.bat       text eol=crlf

# Default behaviour for everything else
*           text=auto eol=lf

