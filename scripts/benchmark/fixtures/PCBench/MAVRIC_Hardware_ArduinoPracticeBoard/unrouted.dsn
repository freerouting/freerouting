    (class kicad_default +5V /ADC0 /ADC1 /ADC2 /ADC3 /ADC6 /ADC7 /MISO /MOSI
      /OSC1 /OSC2 /PB0 /PB1 /PB2 /PD2 /PD3 /PD4 /PD5 /PD6 /PD7 /RST /RX /SCK
