      (pins P3-1 R3-1 R4-1 R7-1 R8-1 U1-1 U1-3 P2-2)
    )
    (net /DISPLAY_RD
      (pins P4-3 P2-3)
    )
    (net /DISPLAY_WR
      (pins Q1-1 R1-2 P2-4)
    )
    (net /SPI_MOSI
      (pins Q4-1 R6-2 P2-7)
    )
    (net /SPI_CS1
      (pins Q2-1 R2-2 P2-8)
    )
    (net /SPI_SCK
      (pins Q3-1 R5-2 P2-9)
    )
    (net /MISO
      (pins P4-10 P2-10)
    )
    (net /BEEP
      (pins P3-10 Q1-2 R3-2)
    )
    (net /SCK
      (pins P4-9 Q3-2 R7-2)
    )
    (net /CS
      (pins P4-7 Q2-2 R4-2)
    )
    (net /MOSI
      (pins P4-5 Q4-2 R8-2)
    )
    (class kicad_default +3V3 +5V /BEEP /CS /DISPLAY_CD /DISPLAY_CS /DISPLAY_D0
      /DISPLAY_D1 /DISPLAY_D2 /DISPLAY_D3 /DISPLAY_D4 /DISPLAY_D5 /DISPLAY_D6
      /DISPLAY_D7 /DISPLAY_RD /DISPLAY_WR /MISO /MOSI /SCK /SPI_CS1 /SPI_MOSI
      /SPI_SCK GND
      (circuit
        (use_via "Via[0-1]_600:400_um")
      )
      (rule
        (width 350)
        (clearance 200)
      )
    )
  )
