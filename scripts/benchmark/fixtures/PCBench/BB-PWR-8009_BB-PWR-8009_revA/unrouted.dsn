      (pins P1-1 D1-2 C1-1 U1-4 U1-1)
    )
    (net GND
      (pins P2-2 P1-2 C1-2 C3-2 C4-2 R2-2 U1-2 R3-1 Ref**_2-0 Ref**-0)
    )
    (net "Net-(C2-Pad1)"
      (pins P2-1 C2-1 C3-1 C4-1 L1-2 R1-1)
    )
    (net "Net-(C2-Pad2)"
      (pins C2-2 R1-2 R2-1 U1-5)
    )
    (net "Net-(L1-Pad1)"
      (pins L1-1 U1-3)
    )
    (net "Net-(D1-Pad1)"
      (pins D1-1 R3-2)
    )
    (class kicad_default GND "Net-(C1-Pad1)" "Net-(C2-Pad1)" "Net-(C2-Pad2)"
      "Net-(D1-Pad1)" "Net-(L1-Pad1)"
      (circuit
        (use_via "Via[0-1]_600:400_um")
      )
      (rule
        (width 304.8)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
