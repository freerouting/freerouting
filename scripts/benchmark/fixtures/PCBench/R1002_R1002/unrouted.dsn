    )
    (net /DN3
      (pins Q2-4 Q2-2 J2-4)
    )
    (net /DN4
      (pins Q1-4 Q1-2 J2-2)
    )
    (class kicad_default +3V3 +5V /DN1 /DN2 /DN3 /DN4 /GN1 /GN2 /GN3 /GN4
      C2D GND HT ID0 ID1 ID2 ID3 PX1 PX2 PX3 PX4 RESERVED0 SCL SDA "~{MRESET}"
      (circuit
        (use_via "Via[0-1]_600:300_um")
