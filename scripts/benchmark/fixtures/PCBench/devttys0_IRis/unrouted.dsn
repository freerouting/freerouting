      (pins C1-1 C4-2 R1-1 R5-2 U1-1 TP1-1)
    )
    (net "Net-(C1-Pad2)"
      (pins C1-2 D1-1 Q1-1 Q1-2 R1-2 U1-4)
    )
    (net "Net-(C2-Pad1)"
      (pins C2-1 R2-2 R3-1 U1-3)
    )
    (net GND
      (pins C2-2 C3-1 C5-1 C6-2 C7-2 D1-2 R2-1 R6-1 R9-1 U1-2 U2-2 BT1-2 P1-2 D2-2)
    )
    (net "Net-(C3-Pad2)"
      (pins C3-2 R4-1 U1-5)
    )
    (net "Net-(C4-Pad1)"
      (pins C4-1 R6-2 R10-1 TP2-1)
    )
    (net "Net-(C5-Pad2)"
      (pins C5-2 R7-1 U2-5)
    )
    (net "Net-(C6-Pad1)"
      (pins C6-1 R8-2 R9-2 U2-4)
    )
    (net +5V
      (pins C7-1 R3-2 R4-2 R7-2 R8-1 BT1-1)
    )
    (net "Net-(Q1-Pad3)"
      (pins Q1-3 Q2-1 Q2-2)
    )
    (net "Net-(P1-Pad1)"
      (pins P1-1 R11-2)
    )
    (net "Net-(Q2-Pad3)"
      (pins Q2-3 Q3-1 Q3-2)
    )
    (net "Net-(Q3-Pad3)"
      (pins R5-1 Q3-3)
    )
    (net "Net-(D2-Pad1)"
      (pins R10-2 U2-3 D2-1 R12-2)
    )
    (net "Net-(R11-Pad1)"
      (pins U2-1 R11-1 R12-1)
    )
    (class kicad_default +5V GND "Net-(C1-Pad1)" "Net-(C1-Pad2)" "Net-(C2-Pad1)"
      "Net-(C3-Pad2)" "Net-(C4-Pad1)" "Net-(C5-Pad2)" "Net-(C6-Pad1)" "Net-(D2-Pad1)"
      "Net-(P1-Pad1)" "Net-(Q1-Pad3)" "Net-(Q2-Pad3)" "Net-(Q3-Pad3)" "Net-(R11-Pad1)"
      (circuit
        (use_via "Via[0-1]_600:400_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
