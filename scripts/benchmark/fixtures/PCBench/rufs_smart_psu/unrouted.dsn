      (pins SW3-2 U2-8)
    )
    (net +BATT
      (pins C3-1 C5-1 IC1-8 R5-2 R6-2 SW2-2 SW3-1 U1-5 U2-3 P3-1)
    )
    (net "Net-(P4-Pad1)"
      (pins P4-1 SW2-3)
    )
    (class kicad_default +BATT GND GNDA "Net-(C1-Pad2)" "Net-(C2-Pad1)" "Net-(C6-Pad1)"
      "Net-(C6-Pad2)" "Net-(D1-Pad1)" "Net-(D1-Pad2)" "Net-(D2-Pad1)" "Net-(D2-Pad2)"
      "Net-(IC1-Pad1)" "Net-(IC1-Pad5)" "Net-(IC1-Pad6)" "Net-(IC1-Pad7)"
      "Net-(P1-Pad6)" "Net-(P4-Pad1)" "Net-(Q1-Pad2)" "Net-(R6-Pad1)" "Net-(SW3-Pad2)"
      VCC
      (circuit
        (use_via "Via[0-1]_600:400_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
