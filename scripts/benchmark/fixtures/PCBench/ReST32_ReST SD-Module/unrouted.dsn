    (class kicad_default +3V3 +5V "/SPI-CS" "/SPI-MISO" "/SPI-MOSI" "/SPI-SCK"
      GND "Net-(D1-Pad2)"
      (circuit
        (use_via "Via[0-1]_600:400_um")
      )
      (rule
        (width 300)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
